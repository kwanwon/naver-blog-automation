    "changelog": [
        "\u2728 [Feature] v1.2.165: \uc774\uc6c3\ubc29\ubb38 \uc18c\ud1b5 \ub300\uae30\uc2dc\uac04\uc744 1~5\ucd08\ub85c \ub300\ud3ed \ub2e8\ucd95\ud558\uc5ec \ube60\ub978 \ucc98\ub9ac\uac00 \uac00\ub2a5\ud558\ub3c4\ub85d \uc5c5\ub370\uc774\ud2b8",
        "\u2728 [Feature] v1.2.164: \ub124\uc774\ubc84 \uce74\ud398 \uc790\ub3d9 \ud3ec\uc2a4\ud305 \uc2dc \uc804\uccb4 \ud14d\uc2a4\ud2b8 \uac00\uc6b4\ub370 \uc815\ub82c \uc801\uc6a9 \ubc0f \ubc34\ub4dc \ub2e8\uc77c \uc2a4\ucf00\uc904\ub7ec \ub0a0\uc528 \uc815\ud655\ub3c4 \uc218\uc815",
        "\u2728 [UX/Prompt Update] v1.2.163: \ube14\ub85c\uadf8 \ud3ec\uc2a4\ud305 \uc2dc \ud329\ud2b8 \uc704\uc8fc\uc758 \ub0a0\uc528 \uc548\ubd80 \ub4a4\uc5d0 \uae00\uc774 \ub69d \ub04a\uae30\uc9c0 \uc54a\ub3c4\ub85d, '\ub0a0\uc528 \uccb4\uac10\uacfc \ubb34\uad00\ud55c \uc815\uc911\ud558\uace0 \ub2e4\uc815\ud55c \uc751\uc6d0 \uc778\uc0ac'\ub97c \ube0c\ub9bf\uc9c0\ub85c \ucd94\uac00\ud558\uc5ec \ubcf8\ubb38\uc73c\ub85c \uc790\uc5f0\uc2a4\ub7fd\uac8c \ub118\uc5b4\uac00\ub3c4\ub85d \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.",
        "\ud83c\udfa8 [Design] v1.2.161: \uc5d1\uc140 \ub2ec\ub825 \ud30c\uc2a4\ud154 \ud14c\ub9c8 \ub514\uc790\uc778 \uc801\uc6a9 - \ub124\uc774\ube44 \ud0c0\uc774\ud2c0 / \uc77c\uc694\uc77c(\uc5f0\ud551\ud06c) / \ud1a0\uc694\uc77c(\uc5f0\ud558\ub298) / \ud3c9\uc77c(\uc5f0\ub77c\uc784) / \uacf5\ud734\uc77c(\ud551\ud06c \ud558\uc774\ub77c\uc774\ud2b8) \uc0c9\uc0c1 \uad6c\ubd84 + \ud14c\ub450\ub9ac \uc804\uccb4 \uc801\uc6a9\uc73c\ub85c \uc778\uc1c4 \uc2dc\uc5d0\ub3c4 \uc120\uba85\ud558\uac8c \ucd9c\ub825\ub428",
        "\ud83d\ude80 [Critical Fix & Update] v1.2.154: (1) \uc5d1\uc140 \uacf5\ud734\uc77c \uc5f0\ub3d9 \ubaa8\ub4c8(holidays) \ub204\ub77d\uc73c\ub85c \uc778\ud55c \uc5d1\uc140 \uae30\ub85d \uc624\ub958 \ud574\uacb0 \ubc0f \ube4c\ub4dc \uc758\uc874\uc131/\ub300\uccb4 \ub9f5 \ucd94\uac00, (2) \ubc34\ub4dc \uc608\uc57d \ud3ec\uc2a4\ud305 \ud3ed\uc5fc/\ubb34\ub354\uc704 \uae30\uc0c1\uccad \uc2e4\uc2dc\uac04 \ub370\uc774\ud130 \ud329\ud2b8 \uc815\ubc00 \uc778\uc6a9 \ubc0f \uc601\ud63c\uc5c6\ub294 \ub0a0\uc528 \uba58\ud2b8/\uac70\uc9d3 \uac10\uc131\uc5b4 \uc6d0\ucc9c \uae08\uc9c0, (3) \uce74\ud398 \ud3ec\uc2a4\ud305 \ub9e4\ubc88 \ubc18\ubcf5\ub418\ub358 \uc0c1\ud22c\uc801 \ud569\uae30\ub3c4 \ud64d\ubcf4 \ubb38\ub2e8 100% \uc0ad\uc81c \ubc0f \uc720\uc775 \uc815\ubcf4 \uc911\uc2ec \uac1c\ud3b8, (4) \uc774\uc6c3 \ube14\ub85c\uadf8 \ubc29\ubb38 \ub313\uae00 \ubd84\ub7c9 2\ubc30 \ud655\ub300(150~300\uc790, 3~5\ubb38\uc7a5) \ubc0f \uad6c\uccb4\uc801 \ubcf8\ubb38 \ub0b4\uc6a9 2\uac1c \uc774\uc0c1 \uc9c1\uc811 \uc778\uc6a9\ud558\ub294 \uc815\uc131\uc2a4\ub7ec\uc6b4 \ub300\ud654\ud615 \ub313\uae00 \uc791\uc131 \uc801\uc6a9",
        "\u2728 [UX Improvement] v1.2.153: 2\ub2e8\uacc4 \uc11c\ube0c\ud0ed\uc740 \uc9c0\uc815\ub41c \ud3f4\ub354\ub85c \ud31d\uc5c5 \uc5c6\uc774 \uc5d1\uc140 \ub2ec\ub825\uc744 \ubc14\ub85c \uc0dd\uc131\ud558\uace0, 3\ub2e8\uacc4 \uc11c\ube0c\ud0ed\uc5d0\uc11c\ub294 \uad00\uc7a5\ub2d8\uc774 \uc6d0\ud558\ub294 \ud2b9\uc815 \uc5d1\uc140 \ud30c\uc77c\uc744 \uc790\uc720\ub86d\uac8c \uc9c0\uc815\ud558\uc5ec \uc791\uc131\ud560 \uc218 \uc788\ub3c4\ub85d \ud30c\uc77c \uc120\ud0dd\ucc3d \ud31d\uc5c5\uc744 \uc81c\uacf5\ud558\ub3c4\ub85d \ub3d9\uc791 \uba85\ud655\ud654",
        "\ud83d\ude80 [Critical Fix] v1.2.152: \uc218\ub828\uacc4\ud68d\ud45c AI \uc0dd\uc131\uc744 \uc704\ud55c \ubaa8\ub4c8(schedule_parser, planner_engine, calendar_writer, openpyxl, pdfplumber \ub4f1)\uc744 \ucd5c\uc0c1\ub2e8\uc5d0 \uba85\uc2dc\uc801 \uc784\ud3ec\ud2b8\ud558\uace0 PyInstaller hidden-import\uc5d0 \ud3ec\ud568\uc2dc\ucf1c \ubc88\ub4e4 \uc571 \uc2e4\ud589 \uc2dc \uc218\ub828\uacc4\ud68d\ud45c \ubc0f \ud15c\ud50c\ub9bf \uc0dd\uc131 \uc2e4\ud328 \ubb38\uc81c \uc644\ubcbd \ud574\uacb0",
        "\u2728 [Feature] v1.2.151: \uc774\uc6c3 \ube14\ub85c\uadf8 \ubc29\ubb38 \uc18c\ud1b5 \uc2dc \ubcf8\ubb38 \uc138\ubd80 \ucee8\ud14c\uc774\ub108(.se-main-container \ub4f1) \uc815\ubc00 \uc218\uc9d1 \ub85c\uc9c1 \uc801\uc6a9 \ubc0f \ubcf8\ubb38 \uad6c\uccb4\uc801 \ub0b4\uc6a9 1~2\uac1c \ud544\uc218 \ud3ec\ud568, PC 1.5~2\uc904(120~180\uc790, 3~4\ubb38\uc7a5) \uc815\uc131\uc2a4\ub7ec\uc6b4 \ub313\uae00 \uc0dd\uc131\uc73c\ub85c AI \ud504\ub86c\ud504\ud2b8 \ub300\ud3ed \uac15\ud654",
        "\ud83d\ude80 [Critical Fix] v1.2.150: \uc8fc\uc2dd \uc790\ub3d9\ub9e4\ub9e4 \ubd07 \ub4f1 \ud0c0 \uc140\ub808\ub2c8\uc6c0 \ud504\ub85c\uadf8\ub7a8\uacfc\uc758 \ud504\ub85c\ud544 \uacf5\uc720 \ubc0f \ud0ed \ud569\uccd0\uc9d0 \ud604\uc0c1 \uc644\ubcbd \ubc29\uc9c0\ub97c \uc704\ud574 \uc804\uc6a9 \ud504\ub85c\ud544\uba85\uc744 naver_automation_profile\ub85c \ucd5c\uc885 \uaca9\ub9ac",
        "\ud83d\ude80 [Critical Fix] v1.2.149: \ud504\ub85c\uc138\uc2a4 \uc815\ub9ac \uc2dc \uc77c\ubc18 \ud06c\ub86c(\uc8fc\uc2dd \ud504\ub85c\uadf8\ub7a8/\uac1c\uc778 \ube0c\ub77c\uc6b0\uc800)\uc744 \ubb34\ucc28\ubcc4 \uc885\ub8cc\ud558\ub358 pkill -f chrome/taskkill chrome.exe \ub85c\uc9c1 \uc644\uc804 \uc81c\uac70 \ubc0f selenium_profile \uad00\ub828 \ud504\ub85c\uc138\uc2a4\ub9cc \uc815\ubc00 \ud0c0\uac9f \uc885\ub8cc\ud558\ub3c4\ub85d \uae34\uae09 \uc218\uc815",
        "\ud83d\ude80 [Critical Fix] v1.2.148: \uc140\ub808\ub2c8\uc6c0 \ud06c\ub86c \uc0ac\uc6a9\uc790 \ub370\uc774\ud130 \ub514\ub809\ud1a0\ub9ac(user-data-dir)\ub97c \uc0ac\uc6a9\uc790 \ub3c5\ub9bd \uacbd\ub85c(~/selenium_profile)\ub85c \ubcc0\uacbd\ud558\uc5ec \uc77c\ubc18 \ud06c\ub86c \ube0c\ub77c\uc6b0\uc800\uc640\uc758 Profile Lock \ucda9\ub3cc \uc644\ubcbd \ubc29\uc9c0 \ubc0f Mac \uc571 \uc5c5\ub370\uc774\ud2b8 \uc2dc \uc138\uc158 \uc720\uc9c0 \ubcf4\uc7a5",
        "\u2728 [Feature] v1.2.147: \ub0b4 \ube14\ub85c\uadf8\uc5d0 \ub2ec\ub9b0 \ub313\uae00(\ud2b9\ud788 \uc2a4\ud338/\uc778\uc0ac\uc131 \ub313\uae00)\uc5d0 \ub300\ud55c \ub2f5\uae00 \uc0dd\uc131 \uc2dc, \ub2e8\uc21c \ub2e8\ub2f5\ud615(\uac10\uc0ac\ud569\ub2c8\ub2e4 \ub4f1)\uc744 \ud53c\ud558\uace0 \uc0c1\ub300\ubc29 \ub313\uae00 \ub0b4\uc6a9\uc744 \ubc18\uc601\ud558\uc5ec 2~3\ubb38\uc7a5\uc73c\ub85c \uc131\uc758 \uc788\uac8c \uc791\uc131\ud558\ub3c4\ub85d AI \ud504\ub86c\ud504\ud2b8 \ub300\ud3ed \uac1c\uc120",
        "\u2728 [Feature] v1.2.146: \uc774\uc6c3 \uc18c\ud1b5(\ub313\uae00) \uc791\uc131 \uc2dc \ub0b4\uc6a9\uc774 \ub108\ubb34 \uc9e7\uc9c0 \uc54a\uac8c(3~4\ubb38\uc7a5, 100~150\uc790 \ub0b4\uc678) \uc131\uc758\uc788\uac8c \uc791\uc131\ub418\ub3c4\ub85d \ud504\ub86c\ud504\ud2b8 \uac1c\uc120",
        "\ud83d\ude80 [Critical Fix] v1.2.145: \uce74\ud398 \uc0ac\uc9c4 \uc5ec\ub7ec \uc7a5(8~10\uc7a5) \ucca8\ubd80 \ud6c4 \ubc31\uadf8\ub77c\uc6b4\ub4dc \ucc98\ub9ac \uc9c0\uc5f0\uc73c\ub85c \uc778\ud574 '\ub4f1\ub85d' \ubc84\ud2bc \ud074\ub9ad\uc774 \uc539\ud788\ub294 \ubb38\uc81c \uc644\ubcbd \ud574\uacb0 (\uac15\uc81c \ud074\ub9ad \ub2e4\uc911 \uc7ac\uc2dc\ub3c4 \ub85c\uc9c1 \ub3c4\uc785)",
        "\u2728 [Feature] v1.2.144: \uce74\ud398 \uc790\ub3d9 \ud3ec\uc2a4\ud305 \uc2dc \uc0ac\uc9c4\uc774 10\uc7a5\uc744 \ucd08\uacfc\ud558\uba74 10\uc7a5 \ub2e8\uc704\ub85c \ubd84\ud560\ud558\uc5ec \uc5f0\uc18d \ud3ec\uc2a4\ud305\ud558\ub294 \uae30\ub2a5 \ucd94\uac00 (\ubcf8\ubb38\uc740 \uccab \uae00\uc5d0\ub9cc \uc791\uc131, \uc774\ud6c4 \uae00\uc740 \uc774\uc5b4\uc9c0\ub294 \uc0ac\uc9c4\uc73c\ub85c \uc81c\ubaa9/\ub0b4\uc6a9 \uc790\ub3d9 \ub300\uccb4)",
        "\ud83d\ude80 [Critical Fix] v1.2.143: \ube4c\ub4dc\ub41c \uc571 \ud658\uacbd(PyInstaller)\uc5d0\uc11c \ub124\uc774\ubc84 \uce74\ud398 \uc790\ub3d9 \ud3ec\uc2a4\ud305 \uc2dc '\ub4f1\ub85d' \ubc84\ud2bc \ud074\ub9ad\uc774 \uc548 \ub418\ub358 \ubb38\uc81c \uc644\ubcbd \ud574\uacb0 (\uac15\uc81c \uc774\ubca4\ud2b8 \uc8fc\uc785 \ubc0f \ube44\ud65c\uc131\ud654 \ud574\uc81c \uc801\uc6a9)",
        "\ud83d\ude80 [Fix] v1.2.142: \ub124\uc774\ubc84 \uce74\ud398 \uc0ac\uc9c4 \ud3ec\ud568 \uc790\ub3d9 \ud3ec\uc2a4\ud305 \uc2dc, '\uc0ac\uc9c4 \ucca8\ubd80 \ubc29\uc2dd' \ud31d\uc5c5\uc744 \uc644\uc804\ud788 \ub2eb\uc9c0 \uc54a\uc544 '\ub4f1\ub85d' \ubc84\ud2bc\uc774 \ud074\ub9ad \uc548 \ub418\ub358 \ud604\uc0c1 \uc218\uc815",
        "\ud83d\ude80 [Fix] v1.2.140: \ub2f5\uae00 \uad00\ub9ac\uc5d0\uc11c '\uc774\ub3d9' \ud074\ub9ad \uc2dc \uc6d0\ub798 \ube14\ub85c\uadf8 \ud3ec\uc2a4\ud305\uc73c\ub85c \uc815\ud655\ud788 \uc774\ub3d9\ud558\ub3c4\ub85d \uc0c8 \ud0ed \uac10\uc9c0 \ucd94\uac00",
        "\ud83d\ude80 [Critical Fix] v1.2.138: Mac/Win \ube4c\ub4dc \uc571\uc5d0\uc11c API \ud0a4(OpenAI, Gemini) \ub85c\ub4dc \uc2e4\ud328 \ud604\uc0c1 \uc644\ubcbd \uc218\uc815 (\uc808\ub300\uacbd\ub85c \ucc38\uc870\ub85c \ubcc0\uacbd)",
        "\ud83d\udc1b [Fix] v1.2.138: \ub2e4\uc911 \uc774\ubbf8\uc9c0 \uc5c5\ub85c\ub4dc \uc2dc 'click \uac00\ub85c\ucc44\uae30 \uc2e4\ud328' \ubc29\uc9c0\ub97c \uc704\ud55c \uc7ac\uc2dc\ub3c4 \ub85c\uc9c1 \ucd94\uac00 (\ub124\uc774\ubc84 \uc5d0\ub514\ud130 \uc9c0\uc5f0 \ub300\uc751)",
        "\ud83d\ude80 [Critical Fix] v1.2.136: Mac \uc571 \ube4c\ub4dc \uc2dc \ubc1c\uc0dd\ud558\ub294 \ubc14\uc774\ub108\ub9ac \uc190\uc0c1(PyInstaller embedded PKG) \ubc84\uadf8 \ud53d\uc2a4",
        "\u2728 [Fix] v1.2.134: \ube4c\ub4dc\ub41c \uc571\uc5d0\uc11c \uc2a4\ub9c8\ud2b8 \ud3f4\ub354 \ub9e4\uce6d \ub8f0 \ud30c\uc77c\uc774 \uc5c6\ub354\ub77c\ub3c4 \ud3f4\ub354\uba85(\uc608: \ub300\ub828, \ub099\ubc95 \ub4f1) \uae30\ubc18 \uc790\ub3d9 \ub9e4\uce6d\uc774 \ub418\ub3c4\ub85d \ub85c\uc9c1 \ubcf4\uc644",
        "\ud83d\ude80 [Critical Fix] v1.2.133: \ube4c\ub4dc\ub41c Mac \uc571\uc5d0\uc11c \uc911\ubcf5 \uc2e4\ud589(\uc0c8 \ucc3d\uc774 \uacc4\uc18d \uc5f4\ub9ac\ub294 \ud604\uc0c1) \ubc29\uc9c0 \ub85c\uc9c1 \ucd94\uac00 (PyInstaller Fork Bomb \ubc84\uadf8 \ud53d\uc2a4)",
        "\u2728 [Update] v1.2.127: \ubc34\ub4dc \uac10\uc9c0 \ubaa8\ub4dc AI \ud504\ub86c\ud504\ud2b8 \uac1c\uc120 (\uc644\uc804\ud55c \ubb38\uc7a5 \uc720\ub3c4)",
        "\ud83d\ude91 [Hotfix] v1.2.126: \ub9e5/\uc708\ub3c4\uc6b0 \uc571 \uc2e4\ud589 \ubd88\uac00 \ud604\uc0c1 (Syntax \\& Indentation Error) \uae34\uae09 \uc218\uc815",
        "\ud83d\udee0\ufe0f [Fix] v1.2.125: \uc774\uc6c3\uc18c\ud1b5 \uc911\ub2e8 \ubc84\uadf8 \uc218\uc815 + \ub0b4 \ub313\uae00 \uc911\ubcf5 \ubc29\uc9c0 \ucd94\uac00",
        "\ud83d\udc1b [Fix] \uad11\uace0\uae00 \uc2a4\ud0b5 \uc2dc continue \ubc84\uadf8\ub85c \uc778\ud55c \uc870\uae30 \uc885\ub8cc \ud604\uc0c1 \ud574\uacb0",
        "\ud83d\udd01 [Fix] \uad11\uace0\uae00 \uc2a4\ud0b5\ud574\ub3c4 interaction_count \uc62c\ub77c\uac00\ub358 \ubb38\uc81c \uc218\uc815",
        "\u2705 [New] \uc774\uc6c3 \uae00 \ubc29\ubb38 \uc2dc \ub0b4 \ub313\uae00\uc774 \uc774\ubbf8 \uc788\uc73c\uba74 \uc790\ub3d9 \uc2a4\ud0b5 (\uc911\ubcf5 \ub313\uae00 \ubc29\uc9c0)",
        "\ud83d\ude80 [Stability] v1.2.124: \uc774\uc6c3\uc18c\ud1b5 \ub0a0\uc528\uc5b8\uae09 \uae08\uc9c0 + \uad11\uace0\uae00 \ud544\ud130\ub9c1 + \ub313\uae00 \uc798\ub9bc \ubc29\uc9c0",
        "\ud83d\ude80 [Stability] v1.2.123: \uc2dc\ub9ac\uc5bc \uc778\uc99d \uc548\uc815\ud654 \ubc0f \uc11c\ubc84 \uc2ac\ub9bd \ub300\uc751 \uac1c\uc120",
        "\ud83d\udee1\ufe0f [Serial] \ub9cc\ub8cc\uc77c \ub85c\uceec \uccb4\ud06c \ucd94\uac00: \uc11c\ubc84 \uc5c6\uc774\ub3c4 \ub9cc\ub8cc\ub41c \uc2dc\ub9ac\uc5bc \uc989\uc2dc \ucc28\ub2e8",
        "\ud83d\udee1\ufe0f [Serial] \uc11c\ubc84 \uba85\uc2dc\uc801 \uac70\ubd80(\ub9cc\ub8cc/\ube14\ub799) vs \uc5f0\uacb0 \uc2e4\ud328(\uc2ac\ub9bd) \ub85c\uc9c1 \uc644\uc804 \ubd84\ub9ac",
        "\u23f0 [Serial] \uc624\ud504\ub77c\uc778 \ud5c8\uc6a9 \uae30\uac04 7\uc77c \u2192 14\uc77c \uc5f0\uc7a5 (\uc544\uce68 \ud504\ub85c\uadf8\ub7a8 \uc2dc\uc791 \ud305\ud637 \ud574\uacb0)",
        "\ud83d\ude80 [Persona] v1.2.122: \uc774\uc6c3 \uc18c\ud1b5 \ubc29\ubb38 \uc720\ub3c4 \uc81c\uac70 \ubc0f \uc9c0\uc5ed \ub9c8\ucf00\ud305 \uc911\ubcf5 \ubc29\uc9c0 \uac15\ud654",
        "\ud83d\udee1\ufe0f [Anti-Spam] \uc774\uc6c3 \ube14\ub85c\uadf8 \ub313\uae00 \uc2dc '\uc81c \ube14\ub85c\uadf8\uc5d0\ub3c4 \ub180\ub7ec\uc624\uc138\uc694' \uac15\uc81c \ucd94\uac00 \ub85c\uc9c1 \uc804\uba74 \uc0ad\uc81c",
        "\ud83d\udee1\ufe0f [Anti-Spam] \uc9c0\uc5ed \ub9c8\ucf00\ud305 URL \uc815\uaddc\ud654 \ub85c\uc9c1 \uace0\ub3c4\ud654: PC/\ubaa8\ubc14\uc77c/\ucffc\ub9ac\ud615 \uc8fc\uc18c \uc911\ubcf5 \uccb4\ud06c \uc644\ubcbd \uc9c0\uc6d0",
        "\u2728 [Persona] \uc774\uc6c3 \uc18c\ud1b5 \uc608\uc2dc \ubb38\uad6c\ub97c \ub354 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uacf5\uac10\ud615 \uba58\ud2b8\ub85c \uad50\uccb4",
        "\ud83d\ude80 [Stability] v1.2.121: AI \ud658\uac01 \uc81c\uac70 \uacb0\uc815\ud310 \ubc0f \uc804 \uc885\ubaa9 \uc911\ub9bd\ud654 \ubc30\ud3ec",
        "\ud83d\udee1\ufe0f [Anti-Hallucination] '\uc591\uc591/\ub0a8\ub300\ucc9c/\uc591\uc591\ucd08' \ub4f1 \ud558\ub4dc\ucf54\ub529 \uc9c0\uba85 \uc804\uba74 \uc0ad\uc81c \ubc0f \uc0ac\uc6a9\uc790 \uc124\uc815 \uc9c0\uc5ed\uba85 \ub3d9\uc801 \uc5f0\ub3d9",
